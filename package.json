{
  "name": "xingyue-desktop",
  "productName": "Xingyue",
  "version": "0.1.11",
  "private": true,
  "description": "A handwritten desktop companion with read-only Codex quota and local usage monitoring.",
  "main": "app/main.cjs",
  "license": "MIT",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "preview": "electron . --preview",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "electron . --ui-test",
    "verify:live": "node scripts/check-live.cjs",
    "assets": "node scripts/fetch-fonts.cjs",
    "build": "node scripts/package.cjs",
    "installer": "node scripts/installer.cjs"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  }
}
